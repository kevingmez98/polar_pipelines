{
    "nodes": [
        {
            "id": "read_south",
            "operation": {"name": "read_csv"},
            "input_ports": [],
            "output_ports": [{"id": "read_south_out", "ordinal": 0}],
            "parameters": {"filepath": "data/netflix_titles.csv"}
        },
        {
            "id": "read_central",
            "operation": {"name": "read_csv"},
            "input_ports": [],
            "output_ports": [{"id": "read_central_out", "ordinal": 0}],
            "parameters": {"filepath": "data/Orders_Central.csv"}
        },
        {
            "id": "join_orders",
            "operation": {"name": "inner_join"},
            "input_ports": [
                {"id": "join_south", "ordinal": 0},
                {"id": "join_central", "ordinal": 1}
            ],
            "output_ports": [{"id": "join_out", "ordinal": 0}],
            "parameters": {
                "left_on": "Customer ID",
                "right_on": "Customer ID",
                "suffixes": ["_south", "_central"]
            }
        },
        {
            "id": "logical_check",
            "operation": {"name": "and"},
            "input_ports": [{"id": "logical_in", "ordinal": 0}],
            "output_ports": [{"id": "logical_out", "ordinal": 0}],
            "parameters": {
                "column": "Profit_south",
                "sentencia1": "Profit_south >= 0",
                "sentencia2": "Profit_south < 100",
                "reemplazar_campo": false,
                "nombre_nueva_columna": "profit_in_range"
            }
        },
        {
            "id": "numeric_absolute_profit",
            "operation": {"name": "absolute"},
            "input_ports": [{"id": "numeric_in", "ordinal": 0}],
            "output_ports": [{"id": "numeric_out", "ordinal": 0}],
            "parameters": {
                "column": "Profit_south",
                "create_new_column": true,
                "new_column_name": "absolute_profit"
            }
        },
        {
            "id": "structural_postal_code",
            "operation": {"name": "change_data_type"},
            "input_ports": [{"id": "structural_in", "ordinal": 0}],
            "output_ports": [{"id": "structural_out", "ordinal": 0}],
            "parameters": {
                "column": "Postal Code_south",
                "target_type": "string",
                "create_new_column": true,
                "new_column_name": "postal_code_text"
            }
        },
        {
            "id": "postal_code_suffix",
            "operation": {"name": "add_column"},
            "input_ports": [{"id": "suffix_in", "ordinal": 0}],
            "output_ports": [{"id": "suffix_out", "ordinal": 0}],
            "parameters": {
                "column_name": "postal_code_suffix",
                "value": "_Concat"
            }
        },
        {
            "id": "concat_postal_code",
            "operation": {"name": "concat"},
            "input_ports": [{"id": "concat_in", "ordinal": 0}],
            "output_ports": [{"id": "concat_out", "ordinal": 0}],
            "parameters": {
                "columns": ["postal_code_text", "postal_code_suffix"],
                "create_new_column": true,
                "new_column_name": "postal_code_concat"
            }
        },
        {
            "id": "text_customer_name",
            "operation": {"name": "lowercase"},
            "input_ports": [{"id": "text_in", "ordinal": 0}],
            "output_ports": [{"id": "text_out", "ordinal": 0}],
            "parameters": {
                "column": "Customer Name_south",
                "create_new_column": true,
                "new_column_name": "customer_name_lower"
            }
        },
        {
            "id": "datetime_order_month",
            "operation": {"name": "extract_date_part"},
            "input_ports": [{"id": "datetime_in", "ordinal": 0}],
            "output_ports": [{"id": "datetime_out", "ordinal": 0}],
            "parameters": {
                "column": "Order Date",
                "part": "month",
                "create_new_column": true,
                "new_column_name": "order_month"
            }
        },
        {
            "id": "drop_unoperated_columns",
            "operation": {"name": "drop_column"},
            "input_ports": [{"id": "drop_in", "ordinal": 0}],
            "output_ports": [{"id": "drop_out", "ordinal": 0}],
            "parameters": {
                "columns": [
                    "Sales_south",
                    "Quantity_south",
                    "Discount",
                    "Region",
                    "State_south",
                    "Row ID_south",
                    "Order ID_south",
                    "Ship Date",
                    "Ship Mode_south",
                    "Customer ID",
                    "Segment_south",
                    "Country_south",
                    "City_south",
                    "Product ID_south",
                    "Category_south",
                    "Sub-Category_south",
                    "Product Name",
                    "Row ID_central",
                    "Order ID_central",
                    "Ship Mode_central",
                    "Customer Name_central",
                    "Segment_central",
                    "Country_central",
                    "City_central",
                    "State_central",
                    "Postal Code_central",
                    "postal_code_suffix",
                    "Product ID_central",
                    "Category_central",
                    "Sub-Category_central",
                    "Product",
                    "Sales_central",
                    "Quantity_central",
                    "Profit_central",
                    "Order Year",
                    "Order Month",
                    "Order Day",
                    "Ship Year",
                    "Ship Month",
                    "Ship Day",
                    "Discounts"
                ]
            }
        },
        {
            "id": "write_output",
            "operation": {"name": "write_csv"},
            "input_ports": [{"id": "write_in", "ordinal": 0}],
            "output_ports": [],
            "parameters": {"filepath": "output/processed_orders.csv"}
        }
    ],
    "edges": [
        {
            "id": "south_to_join",
            "source_node_id": "read_south",
            "target_node_id": "join_orders",
            "source_output_port_id": "read_south_out",
            "target_input_port_id": "join_south"
        },
        {
            "id": "central_to_join",
            "source_node_id": "read_central",
            "target_node_id": "join_orders",
            "source_output_port_id": "read_central_out",
            "target_input_port_id": "join_central"
        },
        {
            "id": "join_to_logical",
            "source_node_id": "join_orders",
            "target_node_id": "logical_check",
            "source_output_port_id": "join_out",
            "target_input_port_id": "logical_in"
        },
        {
            "id": "logical_to_numeric",
            "source_node_id": "logical_check",
            "target_node_id": "numeric_absolute_profit",
            "source_output_port_id": "logical_out",
            "target_input_port_id": "numeric_in"
        },
        {
            "id": "numeric_to_structural",
            "source_node_id": "numeric_absolute_profit",
            "target_node_id": "structural_postal_code",
            "source_output_port_id": "numeric_out",
            "target_input_port_id": "structural_in"
        },
        {
            "id": "structural_to_suffix",
            "source_node_id": "structural_postal_code",
            "target_node_id": "postal_code_suffix",
            "source_output_port_id": "structural_out",
            "target_input_port_id": "suffix_in"
        },
        {
            "id": "suffix_to_concat",
            "source_node_id": "postal_code_suffix",
            "target_node_id": "concat_postal_code",
            "source_output_port_id": "suffix_out",
            "target_input_port_id": "concat_in"
        },
        {
            "id": "concat_to_text",
            "source_node_id": "concat_postal_code",
            "target_node_id": "text_customer_name",
            "source_output_port_id": "concat_out",
            "target_input_port_id": "text_in"
        },
        {
            "id": "text_to_datetime",
            "source_node_id": "text_customer_name",
            "target_node_id": "datetime_order_month",
            "source_output_port_id": "text_out",
            "target_input_port_id": "datetime_in"
        },
        {
            "id": "datetime_to_drop",
            "source_node_id": "datetime_order_month",
            "target_node_id": "drop_unoperated_columns",
            "source_output_port_id": "datetime_out",
            "target_input_port_id": "drop_in"
        },
        {
            "id": "drop_to_output",
            "source_node_id": "drop_unoperated_columns",
            "target_node_id": "write_output",
            "source_output_port_id": "drop_out",
            "target_input_port_id": "write_in"
        }
    ]
}
